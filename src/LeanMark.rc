#include <windows.h>
#include "resource.h"

IDI_LEANMARK ICON "LeanMark.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Abdulfatah Bahbouh"
            VALUE "FileDescription", "LeanMark Markdown Reader"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "LeanMark"
            VALUE "LegalCopyright", "Copyright (c) 2026 Abdulfatah Bahbouh"
            VALUE "OriginalFilename", "LeanMark.exe"
            VALUE "ProductName", "LeanMark"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
